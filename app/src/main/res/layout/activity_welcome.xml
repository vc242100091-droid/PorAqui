<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcome_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_stitch_splash_gradient"
    tools:context=".ui.auth.WelcomeActivity">

    <!-- Centerpiece Content -->
    <LinearLayout
        android:id="@+id/welcome_center_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/welcome_bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Header Welcome Badge -->
        <TextView
            android:id="@+id/tv_welcome_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stitch_welcome_badge"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="👋 ¡Bienvenido!"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Logo PNG con transparencia -->
        <ImageView
            android:id="@+id/iv_welcome_logo"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="20dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/poraqui_sin_fondo" />

        <!-- Slogan Title -->
        <TextView
            android:id="@+id/tv_welcome_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="Descubre lo que\nhay cerca de ti" />

    </LinearLayout>

    <!-- Bottom Actions Area -->
    <LinearLayout
        android:id="@+id/welcome_bottom_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Primary CTA: Login -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_welcome_login"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_stitch_btn_primary"
            android:text="Iniciar sesión"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Secondary CTA: Register -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_welcome_register"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_stitch_btn_secondary"
            android:text="Registrarme gratis"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Guest Entry Option -->
        <TextView
            android:id="@+id/tv_welcome_guest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="¿Quieres explorar primero? Entrar como invitado →"
            android:textColor="@color/stitch_emerald_bright"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>